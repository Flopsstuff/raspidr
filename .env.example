# RaspiDR configuration. Copy and fill in:  cp .env.example .env
# .env is gitignored. deploy.sh copies it to the Pi, where the assistant reads it too.
# Format: KEY=value, one per line, no quotes needed, comments only on their own lines.

# --- Raspberry Pi (used by deploy.sh on your computer) -------------------------------------------
# ssh host or alias of the speaker (from ~/.ssh/config or mDNS name)
PI_HOST=raspberrypi.local
# project directory on the Pi, relative to the home directory
PI_DIR=raspidr

# --- Hermes Agent: the LLM brain (OpenAI-compatible API, usually in your LAN) --------------------
# base URL including /v1
HERMES_API_URL=http://192.168.0.10:8642/v1
# bearer token of the Hermes API server
HERMES_API_KEY=
# model id reported by GET /v1/models
HERMES_MODEL=hermes-agent

# --- Groq: speech-to-text (whisper-large-v3-turbo) and text-to-speech (orpheus) -----------------
# https://console.groq.com/keys (free tier: TTS is limited to 10 requests/min)
GROQ_API_KEY=

# --- xAI: fallback TTS when Groq is rate-limited + synthetic samples for wake word training -----
# https://console.x.ai
XAI_API_KEY=
